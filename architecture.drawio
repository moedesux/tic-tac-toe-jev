<mxfile host="app.diagrams.net">
  <diagram name="Jev command architecture">
    <mxGraphModel grid="1" page="1" pageWidth="1500" pageHeight="700">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="browser" value="Browser entry point&#10;Structured Controls + Natural-Language Controls" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fe;strokeColor=#475569;">
          <mxGeometry as="geometry" x="20" y="60" width="240" height="115" />
        </mxCell>
        <mxCell id="standalone" value="Standalone microphone entry point&#10;local Qwen ASR + Kokoro TTS&#10;BackendCommandClient" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fe;strokeColor=#475569;">
          <mxGeometry as="geometry" x="20" y="260" width="240" height="115" />
        </mxCell>
        <mxCell id="api" value="FastAPI routes&#10;/api/game/command&#10;direct game + speech endpoints" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fe;strokeColor=#475569;">
          <mxGeometry as="geometry" x="300" y="60" width="240" height="115" />
        </mxCell>
        <mxCell id="processor" value="Player Command module&#10;PlayerCommandProcessor&#10;confidence policy + response text" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fe;strokeColor=#475569;">
          <mxGeometry as="geometry" x="580" y="60" width="240" height="115" />
        </mxCell>
        <mxCell id="adapter" value="Jev command adapter&#10;JevCommandInterpreter&#10;batched typed judgments" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fe;strokeColor=#475569;">
          <mxGeometry as="geometry" x="860" y="60" width="240" height="115" />
        </mxCell>
        <mxCell id="remote" value="TypeSafe Jev 1.13.0&#10;server-side credentials&#10;application-lifetime SDK client" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fe;strokeColor=#475569;">
          <mxGeometry as="geometry" x="1140" y="60" width="240" height="115" />
        </mxCell>
        <mxCell id="session" value="Shared GameSession&#10;one async lock&#10;game rules + board + current mark" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fe;strokeColor=#475569;">
          <mxGeometry as="geometry" x="580" y="310" width="240" height="115" />
        </mxCell>
        <mxCell id="pending" value="Pending Command&#10;missing Move Position&#10;or proposed position confirmation" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fe;strokeColor=#475569;">
          <mxGeometry as="geometry" x="860" y="310" width="240" height="115" />
        </mxCell>
        <mxCell id="speech" value="Retained local speech&#10;Qwen ASR + Kokoro TTS&#10;/api/voice/transcribe + synthesize" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fe;strokeColor=#475569;">
          <mxGeometry as="geometry" x="300" y="460" width="240" height="115" />
